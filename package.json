{
  "name": "syndikat-web",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:assets": "run-p build:svelte build:css",
    "build:critical": "node critical.js",
    "build:css": "node scripts/minify-css.mjs",
    "build:jekyll": "JEKYLL_ENV=production mise exec -- bundle exec jekyll build",
    "build:svelte": "rollup -c svelte-components/rollup.config.js",
    "build": "run-s build:assets build:jekyll build:critical",
    "clean": "mise exec -- bundle exec jekyll clean",
    "clean:discs": "node scripts/dedupe-discs.mjs",
    "dev:jekyll": "mise exec -- bundle exec jekyll serve",
    "dev:svelte": "rollup -c svelte-components/rollup.config.js -w",
    "dev": "run-p dev:svelte dev:jekyll",
    "start": "npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.5",
    "awesomplete": "^1.1.7",
    "clean-css": "^5.3.3",
    "concurrently": "^9.2.1",
    "lucide-static": "^1.12.0",
    "lucide-svelte": "^1.0.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.15.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-svelte": "^7.1.2",
    "svelte": "^3.55.0",
    "svelte-spa-router": "^4.0.1",
    "tippy.js": "^6.3.7",
    "critical": "^9.0.0",
    "rollup-plugin-esbuild-minify": "^1.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
