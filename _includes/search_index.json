[
  {% assign search_posts = '' | localized_posts %}
  {% for post in search_posts %}
    {%- capture article_content -%}
      {%- include components/post_card.html item=post lazy=false -%}
    {%- endcapture -%}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}",
      "content"  : "{{ post.content | strip_html | strip_newlines | remove_chars | escape }}",
      "article"  : "{{- article_content | strip_newlines | replace: '"', '\"' -}}"

    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if search_posts.size > 0 %},{% endif %}
  {% assign search_pages = site.pages | where: 'lang', include.lang %}
  {% for page in search_pages %}
    {%- capture article_content -%}
      {%- include components/post_card.html item=page lazy=false -%}
    {%- endcapture -%}
    {
      {% if page.title != nil %}
        "title"    : "{{ page.title | escape }}",
        "category" : "{{ page.category }}",
        "tags"     : "{{ page.tags | join: ', ' }}",
        "url"      : "{{ site.baseurl }}{{ page.url }}",
        "date"     : "{{ page.date }}",
        "content": "{{ page.content | strip_html | strip_newlines | remove_chars | escape }}",
        "article"  : "{{- article_content | strip_newlines | replace: '"', '\"' -}}"
      {% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]